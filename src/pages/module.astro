---
/**
 * Module — the composed inventory of this build plus the update actions.
 *
 * The list is baked in at build time (`virtual:frontend-modules`, produced by
 * coreFrontendBase from the product's package.json + node_modules): a static
 * build has no other way to know what it was composed from. Everything live —
 * the published versions and the deploy dispatch — comes from the API.
 *
 * Injected into BOTH product targets, but only the admin build links it in the
 * nav; the API gates every route behind `isAdmin` regardless.
 */
import Layout from "../layouts/Layout.astro";
import ModulesAdmin from "../components/ModulesAdmin.tsx";
import { modules } from "virtual:frontend-modules";
---

<Layout title="Module">
  <section class="tds-page">
    <div class="tds-page__head">
      <div>
        <p class="tds-page__eyebrow">System</p>
        <h1 class="tds-page__title">Module</h1>
        <p class="tds-page__lede">
          Installierte und verfügbare Version jedes komponierten Moduls — und die Pipelines, die eine
          neuere Version in Betrieb nehmen.
        </p>
      </div>
    </div>
    <ModulesAdmin client:load modules={modules} />
  </section>
</Layout>
