---
// Einstellungen — the settings HOST. Renders every settings section contributed
// by the enabled extensions (via virtual:frontend-settings), the same way the
// Dashboard hosts widgets. Base-service settings (once ported) render above.
import Layout from "../layouts/Layout.astro";
import CorsSettings from "../components/CorsSettings.tsx";
import MailSettings from "../components/MailSettings.tsx";
import ModuleDeploySettings from "../components/ModuleDeploySettings.tsx";
import SiteKeysSettings from "../components/SiteKeysSettings.tsx";
import { settings } from "virtual:frontend-settings";
import { FRONTEND_TARGET } from "../config/target";

// Base-service settings render above the extension sections. Module & Deployment,
// E-Mail (SMTP), Site-Verbindungen and CORS are admin-product-only: the customer
// portal is neither the place to start a production pipeline, nor to configure the
// platform's outgoing mail, nor to hand out the credentials the public sites
// connect with, nor to decide which origins may call the API (the API gates all
// four on `isAdmin` either way).
//
// Site-Verbindungen sits directly above CORS on purpose: a key is useless to a
// site whose origin the allow-list rejects, and reading the two next to each
// other is what makes that obvious.
const showAdminSettings = FRONTEND_TARGET === "admin";
---

<Layout title="Einstellungen">
  <section class="tds-page">
    <div class="tds-page__head">
      <div>
        <p class="tds-page__eyebrow">Konfiguration</p>
        <h1 class="tds-page__title">Einstellungen</h1>
      </div>
    </div>
    {settings.length === 0 && !showAdminSettings ? (
      <p class="tds-empty">Keine Einstellungen verfügbar.</p>
    ) : null}
    <div class="settings-list flex flex-col gap-6">
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="mail">
            <h2 class="tds-settings-section__title">E-Mail (SMTP)</h2>
            <MailSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="sites">
            <h2 class="tds-settings-section__title">Site-Verbindungen</h2>
            <SiteKeysSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="cors">
            <h2 class="tds-settings-section__title">CORS / Freigegebene Origins</h2>
            <CorsSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="modules">
            <h2 class="tds-settings-section__title">Module &amp; Deployment</h2>
            <ModuleDeploySettings client:load />
          </section>
        ) : null
      }
      {
        settings.map((panel) => {
          const Panel = panel.Component as any;
          return (
            <section class="tds-settings-section" data-settings={panel.id}>
              <h2 class="tds-settings-section__title">{panel.label}</h2>
              <Panel />
            </section>
          );
        })
      }
    </div>
  </section>
</Layout>
