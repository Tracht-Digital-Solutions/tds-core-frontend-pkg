---
/**
 * The `/wiki` FAQ — one native `<details>` per entry, so it works without JS
 * (the whole page is static) and keeps keyboard + screen-reader semantics for
 * free. No island, no CSS: the card geometry is `.tds-card` from tds-shared and
 * the rest are Tailwind utilities, which the host's `@source` directive picks up.
 *
 * Answers are plain text (see content/faq.ts) and are interpolated, never
 * `set:html` — an entry can't inject markup into the shell.
 */
import type { FaqEntry } from "../content/faq";

interface Props {
  entries: FaqEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length === 0 ? (
    <p class="tds-empty">Keine Einträge.</p>
  ) : (
    <div class="tds-stack">
      {entries.map((entry) => (
        <details id={`faq-${entry.id}`} class="tds-card p-4">
          <summary class="cursor-pointer font-semibold">{entry.question}</summary>
          <div class="mt-3 flex flex-col gap-2 text-sm opacity-80">
            {entry.answer.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  )
}
