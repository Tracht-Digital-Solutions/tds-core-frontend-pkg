---
// Einstellungen — the settings HOST. Renders every settings section contributed
// by the enabled extensions (via virtual:frontend-settings), the same way the
// Dashboard hosts widgets. Base-service settings (once ported) render above.
import Layout from "../layouts/Layout.astro";
import CorsSettings from "../components/CorsSettings.tsx";
import MailSettings from "../components/MailSettings.tsx";
import StripeSettings from "../components/StripeSettings.tsx";
import SitemapSettings from "../components/SitemapSettings.tsx";
import { settings } from "virtual:frontend-settings";
import { FRONTEND_TARGET } from "../config/target";
import { BASE_SETTINGS, sectionReveal, settingsSections } from "../lib/settingsSections";

// Base-service settings render above the extension sections. E-Mail (SMTP) and
// CORS are admin-product-only. Public-site connections deliberately live inside
// the settings of the blog, website or tools resource they belong to; GitHub and
// deployment configuration is a release concern and is never exposed here.
const showAdminSettings = FRONTEND_TARGET === "admin";

// Base titles come from lib/settingsSections.ts, which the quick search reads
// too — one spelling per section.
const baseLabel = (id: string) => BASE_SETTINGS.find((s) => s.id === id)?.label ?? id;

// The section index: one link per section, in page order. Each link carries its
// section's reveal attributes, so revealNav shows and hides the two together.
const index = settingsSections(settings).map((section) => ({ ...section, ...sectionReveal(section) }));
---

<Layout title="Einstellungen">
  <section class="tds-page">
    <div class="tds-page__head">
      <div>
        <p class="tds-page__eyebrow">Konfiguration</p>
        <h1 class="tds-page__title">Einstellungen</h1>
      </div>
    </div>
    {/* Shown by revealNav when no section is left for this account; the page is
        reachable by URL even where the nav row stays hidden. */}
    <p class="tds-empty" data-settings-empty hidden={settings.length > 0 || showAdminSettings}>
      Für Ihr Konto gibt es hier nichts einzustellen. Darstellung und Passwort
      ändern Sie im <a href="/profil" class="link-underline">Profil</a>.
    </p>
    <div class="settings-layout">
    <nav class="settings-index" aria-label="Abschnitte" data-settings-index>
      <p class="tds-dropdown__caption">Abschnitte</p>
      <ul>
        {
          index.map((section) => (
            <li data-reveal-for={section.revealFor} data-reveal-permission={section.permission} hidden>
              <a class="settings-index__link" href={`#settings-${section.id}`} data-settings-link={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="settings-list flex flex-col gap-6">
      {
        showAdminSettings ? (
          <section class="tds-settings-section" id="settings-mail" data-settings="mail" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">{baseLabel("mail")}</h2>
            <MailSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <section class="tds-settings-section" id="settings-stripe" data-settings="stripe" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">{baseLabel("stripe")}</h2>
            <StripeSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <>
          <section class="tds-settings-section" id="settings-cors" data-settings="cors" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">{baseLabel("cors")}</h2>
            <CorsSettings client:load />
          </section>
          <section class="tds-settings-section" id="settings-sitemap" data-settings="sitemap" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">{baseLabel("sitemap")}</h2>
            <SitemapSettings client:visible />
          </section>
          </>
        ) : null
      }
      {
        settings.map((panel) => {
          const Panel = panel.Component as any;
          return (
            <section
              class="tds-settings-section"
              id={`settings-${panel.id}`}
              data-settings={panel.id}
              data-reveal-permission={panel.permission}
              data-reveal-for={panel.permission ? undefined : "platform-admin"}
              hidden
            >
              <h2 class="tds-settings-section__title">{panel.label}</h2>
              <Panel />
            </section>
          );
        })
      }
    </div>
    </div>
  </section>
</Layout>

<script>
  // Anchors for the setup wizard (`/einstellungen#settings-<id>`) and a
  // "nicht eingerichtet" chip on every section that still has an open item.
  //
  // Sections render `hidden` until revealNav applies the account's rights, so
  // a browser's own jump to the anchor lands on nothing; this waits for the
  // section to be shown and then scrolls to it.
  import { loadSetupStatus, unconfiguredSections } from "../lib/setupStatus";

  async function markSections() {
    const status = await loadSetupStatus();
    if (!status) return;
    for (const [id, items] of unconfiguredSections(status)) {
      const title = document.querySelector(`#settings-${CSS.escape(id)} .tds-settings-section__title`);
      if (!title || title.querySelector(".setup-missing")) continue;
      const chip = document.createElement("span");
      chip.className = "chip chip--warning setup-missing";
      chip.textContent = "nicht eingerichtet";
      chip.title = items.map((item) => item.title).join(" · ");
      title.append(" ", chip);
      // The index says it too: the open section is findable without scrolling.
      const link = document.querySelector(`[data-settings-link="${CSS.escape(id)}"]`);
      if (link && !link.querySelector(".setup-missing")) {
        const dot = chip.cloneNode(true) as HTMLElement;
        dot.textContent = "offen";
        link.append(" ", dot);
      }
    }
  }

  function scrollToAnchor() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id.startsWith("settings-")) return;
    const target = document.getElementById(id);
    if (!target) return;
    const started = performance.now();
    // The sections above load their islands AFTER the jump and grow, which
    // pushed the target out of view again. Keep it anchored while the layout
    // settles — until the reader scrolls on their own.
    let userMoved = false;
    const stop = () => (userMoved = true);
    for (const type of ["wheel", "touchstart", "keydown"]) {
      window.addEventListener(type, stop, { once: true, passive: true });
    }
    let shownAt = 0;
    const tick = () => {
      const now = performance.now();
      if (userMoved || now - started > 6000) return;
      if (!target.hidden) {
        if (shownAt === 0) shownAt = now;
        if (Math.abs(target.getBoundingClientRect().top) > 4) target.scrollIntoView({ block: "start" });
        if (now - shownAt > 2000) return;
      }
      requestAnimationFrame(tick);
    };
    tick();
  }

  // Scroll-spy: the index marks the section being read. The section whose top
  // last crossed the upper fifth of the viewport is the current one.
  let spy: IntersectionObserver | null = null;
  function watchSections() {
    spy?.disconnect();
    const links = new Map<string, HTMLElement>();
    for (const link of document.querySelectorAll<HTMLElement>("[data-settings-link]")) {
      links.set(`settings-${link.dataset.settingsLink}`, link);
    }
    if (links.size === 0 || typeof IntersectionObserver === "undefined") return;
    const visible = new Set<string>();
    const mark = () => {
      const sections = [...document.querySelectorAll<HTMLElement>(".tds-settings-section:not([hidden])")];
      const current = sections.find((s) => visible.has(s.id)) ?? null;
      for (const [id, link] of links) {
        if (current && id === current.id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };
    spy = new IntersectionObserver(
      (records) => {
        for (const r of records) {
          if (r.isIntersecting) visible.add(r.target.id);
          else visible.delete(r.target.id);
        }
        mark();
      },
      { rootMargin: "-80px 0px -60% 0px" },
    );
    for (const section of document.querySelectorAll(".tds-settings-section")) spy.observe(section);
  }

  document.addEventListener("astro:page-load", () => {
    if (!location.pathname.startsWith("/einstellungen")) return;
    void markSections();
    scrollToAnchor();
    watchSections();
  });
  // The quick search (and the index) jump to a section on this same page; the
  // router only moves the hash, so follow it while the section is still hidden
  // or its islands are still growing.
  window.addEventListener("hashchange", () => {
    if (location.pathname.startsWith("/einstellungen")) scrollToAnchor();
  });
  document.addEventListener("astro:before-swap", () => {
    spy?.disconnect();
    spy = null;
  });
</script>
