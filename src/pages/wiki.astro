---
/**
 * `/wiki` — TWO different wikis behind one route, chosen by the product target.
 *
 *   admin    → the API reference, and nothing else. A structured, collapsible
 *              description of every route the composed backend serves.
 *   customer → FAQs and handbooks for the software the customer has been given,
 *              and nothing else. No API.
 *
 * One route rather than two because the injected base-route set is the same for
 * both products (`coreFrontendBase` takes no target), and because "Wiki" is the
 * same idea in both places — only its content differs. The two branches are
 * mutually exclusive: this is not a page with an optional section.
 *
 * The customer half reads its content from the database through `/help/*`,
 * maintained under *Wiki-Inhalte* in the admin frontend. There is deliberately
 * no code-side FAQ list any more.
 */
import Layout from "../layouts/Layout.astro";
import ApiReference from "../components/ApiReference.tsx";
import HelpCenter from "../components/HelpCenter.tsx";
import { FRONTEND_TARGET } from "../config/target";
import { modules } from "virtual:frontend-modules";

const isAdmin = FRONTEND_TARGET === "admin";
---

{
  isAdmin ? (
    <Layout title="API-Referenz">
      <section class="tds-page">
        <div class="tds-page__head">
          <div>
            <p class="tds-page__eyebrow">Referenz</p>
            <h1 class="tds-page__title">API-Referenz</h1>
            <p class="tds-page__lede max-w-2xl">
              Jede Route der Basis und aller komponierten Module — Zweck, Parameter,
              Antworten und das benötigte Recht. Die Liste entsteht aus den
              registrierten Slim-Routen, die Beschreibungen liefern die Module selbst.
              Rein intern.
            </p>
          </div>
        </div>
        <ApiReference client:load modules={modules} />
      </section>
    </Layout>
  ) : (
    <Layout title="Hilfe">
      <section class="tds-page">
        <div class="tds-page__head">
          <div>
            <p class="tds-page__eyebrow">Wiki</p>
            <h1 class="tds-page__title">Hilfe & Handbücher</h1>
            <p class="tds-page__lede max-w-2xl">
              Antworten auf häufige Fragen und Anleitungen zur Bedienung Ihrer
              Software. Finden Sie hier nicht, was Sie suchen, hilft Ihnen der
              Support gern weiter.
            </p>
          </div>
        </div>
        <HelpCenter client:load />
      </section>
    </Layout>
  )
}
