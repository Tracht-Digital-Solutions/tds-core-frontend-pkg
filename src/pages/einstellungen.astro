---
// Einstellungen — the settings HOST. Renders every settings section contributed
// by the enabled extensions (via virtual:frontend-settings), the same way the
// Dashboard hosts widgets. Base-service settings (once ported) render above.
import Layout from "../layouts/Layout.astro";
import CorsSettings from "../components/CorsSettings.tsx";
import MailSettings from "../components/MailSettings.tsx";
import StripeSettings from "../components/StripeSettings.tsx";
import SitemapSettings from "../components/SitemapSettings.tsx";
import { settings } from "virtual:frontend-settings";
import { FRONTEND_TARGET } from "../config/target";

// Base-service settings render above the extension sections. E-Mail (SMTP) and
// CORS are admin-product-only. Public-site connections deliberately live inside
// the settings of the blog, website or tools resource they belong to; GitHub and
// deployment configuration is a release concern and is never exposed here.
const showAdminSettings = FRONTEND_TARGET === "admin";
---

<Layout title="Einstellungen">
  <section class="tds-page">
    <div class="tds-page__head">
      <div>
        <p class="tds-page__eyebrow">Konfiguration</p>
        <h1 class="tds-page__title">Einstellungen</h1>
      </div>
    </div>
    {/* Shown by revealNav when no section is left for this account; the page is
        reachable by URL even where the nav row stays hidden. */}
    <p class="tds-empty" data-settings-empty hidden={settings.length > 0 || showAdminSettings}>
      Für Ihr Konto gibt es hier nichts einzustellen. Darstellung und Passwort
      ändern Sie im <a href="/profil" class="link-underline">Profil</a>.
    </p>
    <div class="settings-list flex flex-col gap-6">
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="mail" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">E-Mail (SMTP)</h2>
            <MailSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <section class="tds-settings-section" data-settings="stripe" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">Zahlungen (Stripe)</h2>
            <StripeSettings client:load />
          </section>
        ) : null
      }
      {
        showAdminSettings ? (
          <>
          <section class="tds-settings-section" data-settings="cors" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">CORS / Freigegebene Origins</h2>
            <CorsSettings client:load />
          </section>
          <section class="tds-settings-section" data-settings="sitemap" data-reveal-for="platform-admin" hidden>
            <h2 class="tds-settings-section__title">Suchmaschinen (Sitemap)</h2>
            <SitemapSettings client:visible />
          </section>
          </>
        ) : null
      }
      {
        settings.map((panel) => {
          const Panel = panel.Component as any;
          return (
            <section
              class="tds-settings-section"
              data-settings={panel.id}
              data-reveal-permission={panel.permission}
              data-reveal-for={panel.permission ? undefined : "platform-admin"}
              hidden
            >
              <h2 class="tds-settings-section__title">{panel.label}</h2>
              <Panel />
            </section>
          );
        })
      }
    </div>
  </section>
</Layout>
