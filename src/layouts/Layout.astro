---
// Fonts must be JS imports here (not @import in global.css): @tailwindcss/postcss
// inlines CSS @imports without rebasing the packages' url(./files/*.woff2) refs,
// so Vite never emits the woff2. See tds-admin/AGENTS.md.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import {
  CookieNotice,
  LiveChatCta,
  ThemeToggle,
  ToastHost,
} from "@tracht-digital-solutions/tds-shared/components";
import { themeBootstrapScript } from "@tracht-digital-solutions/tds-shared/astro";
import BrandWordmark from "../components/BrandWordmark.astro";
import Icon from "../components/Icon.astro";
import UserMenu from "../components/UserMenu.tsx";
import NavList, { type NavSection } from "../components/NavList.astro";
import { groupLabel, hueForKey, normaliseGroup } from "../lib/panelHues";
import { registry } from "virtual:frontend-registry";
// BRAND_SUFFIX is deliberately NOT imported here — it is consumed only by
// <BrandWordmark />, which keeps the shell's single per-target value in one place.
import { HINT_PREFIX, LOGIN_URL, FRONTEND_TARGET } from "../config/target";
import { API_BASE } from "../lib/auth";

const hintKey = `${HINT_PREFIX}_authed`;
const expKey = `${HINT_PREFIX}_authed_exp`;
const confirmedKey = `${HINT_PREFIX}_confirmed`;

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Skip the gated chrome — used by /login itself. */
  bare?: boolean;
}

const {
  title,
  description = "Internes Panel — Tracht Digital Solutions.",
  lang = "de",
  bare = false,
} = Astro.props;

const authApiUrl =
  (import.meta.env.PUBLIC_AUTH_API_URL as string | undefined) ??
  "https://api.tracht-digital.de/auth";

// One entry as the nav model carries it, before active-state resolution.
interface NavInput {
  href: string;
  label: string;
  id?: string | undefined;
  icon?: string | undefined;
  order: number;
  /** Nav section. Defaults to BASE_GROUP; set it to join an extension's group. */
  group?: string | undefined;
  /** Absolute link to another property — opens in a new tab (see below). */
  external?: boolean | undefined;
  /** Render hidden and unhide at runtime — see NavList and `revealNav`. */
  revealFor?: "company-admin" | "platform-admin" | undefined;
}

// Base-service nav, declared as data so the desktop rail and the mobile drawer
// render from ONE source instead of two hand-kept copies. The `icon` keys are
// resolved by components/Icon.astro; `order` keeps these ahead of any
// extension that targets this same group.
const BASE_GROUP = "verwaltung";
const baseNav: NavInput[] = [
  { href: "/", label: "Dashboard", id: undefined, icon: "layout-dashboard", order: 0 },
  // Platform-admin only, and revealed the same way `/firma` is. It used to hang
  // in the nav of BOTH products unconditionally, so every portal user was
  // invited to a screen whose very first call answers 403.
  { href: "/users", label: "Benutzer", id: "users", icon: "users", order: 1, revealFor: "platform-admin" },
  // The company admin's own user management. Rendered hidden and revealed by
  // the shell script once /me confirms the role — the nav is built at BUILD
  // time and cannot know it. In BOTH products: a company admin signs in to the
  // portal, and the Firmen extension is admin-product only.
  {
    href: "/firma",
    label: "Meine Firma",
    id: "firma",
    icon: "building",
    order: 2,
    revealFor: "company-admin",
  },
  // One route, two wikis (see pages/wiki.astro): the admin build gets the API
  // reference, the portal gets FAQs and handbooks. The label and icon follow the
  // content, because "Wiki" told a customer nothing about what is behind it.
  {
    href: "/wiki",
    label: FRONTEND_TARGET === "admin" ? "API-Referenz" : "Hilfe",
    id: "wiki",
    icon: FRONTEND_TARGET === "admin" ? "book-open" : "life-buoy",
    order: 3,
  },
  { href: "/einstellungen", label: "Einstellungen", id: "einstellungen", icon: "settings", order: 4 },
];

// Module lists what this build is composed of and starts the deploy pipelines.
// Admin-product only: the route is injected into both targets (one route list),
// but the customer portal must not advertise a production deploy — and the API
// gates every /admin/modules route on `isAdmin` regardless of who finds the URL.
if (FRONTEND_TARGET === "admin") {
  baseNav.push({ href: "/module", label: "Module", id: "module", icon: "package", order: 5 });

  // The PUBLIC tools site. It joins the `tools` group so it sits beside the
  // tools extension's own "Tools" entry (`/tools-verwaltung`, the catalog
  // editor) — the label says "Website" precisely because those two are one
  // click apart and easy to confuse.
  //
  // Opens in a NEW TAB, unlike the same-tab cross-property links on the public
  // sites: someone in the panel is mid-task, and replacing their working
  // context with a public catalog loses their place.
  baseNav.push({
    href: "https://tools.tracht-digital.de",
    label: "Tools-Website",
    id: "tools-site",
    icon: "external-link",
    group: "tools",
    order: 90,
    external: true,
  });
}

// Group the composed nav for rendering: extensions contribute { group, order,
// icon }. Keys are normalised (trimmed + lowercased) so an extension writing
// "Verwaltung" lands in the SAME section as the base shell instead of growing
// a duplicate heading with one orphaned link under it. Seeding the map with
// the base group also fixes the section order: Verwaltung stays first, then
// extension groups in first-appearance order.
const groups = new Map<string, NavInput[]>();
// Seed with the base group's own entries FIRST — that is what pins Verwaltung
// as the leading section. Base entries naming another group are held back and
// merged after the extensions, so joining a group never reorders the sections.
groups.set(
  BASE_GROUP,
  baseNav.filter((item) => item.group === undefined),
);
const adoptedBaseNav = baseNav.filter((item) => item.group !== undefined);
for (const item of registry.nav) {
  const key = normaliseGroup(item.group);
  const bucket = groups.get(key) ?? [];
  bucket.push({
    href: item.href,
    label: item.label,
    id: item.id,
    // `NavEntry.icon` has been in the contract from the start and every
    // extension declares one; until now the shell dropped it here.
    icon: item.icon,
    order: item.order ?? 100,
  });
  groups.set(key, bucket);
}

// Base entries that named an extension's group join it now. A group the
// extensions never created is skipped rather than invented: a section heading
// with one external link under it and nothing else reads as a bug.
for (const item of adoptedBaseNav) {
  const key = normaliseGroup(item.group);
  const bucket = groups.get(key);
  if (bucket) bucket.push(item);
}

// Active-nav resolution. `.nav-item--active` (tinted fill + 2px indicator bar)
// has always existed in the shared app.css, and the links have always carried
// `data-nav` — but nothing ever READ either, so the active treatment was dead
// code and the panel had no wayfinding at all. Compare normalised paths so
// `trailingSlash: "ignore"` and the `build.format: "directory"` output both
// match.
const norm = (p: string) => {
  const trimmed = p.replace(/\/+$/, "");
  return trimmed === "" ? "/" : trimmed;
};
const here = norm(Astro.url.pathname);
/** Dashboard matches only exactly; every other entry also matches its subtree. */
const isActive = (href: string) => {
  const h = norm(href);
  return h === "/" ? here === "/" : here === h || here.startsWith(h + "/");
};

/**
 * SHELL ANATOMY — documented here rather than inline; see the gotcha below.
 *
 *   header.lg:hidden      mobile top bar (below lg): wordmark, ThemeToggle and
 *                         the drawer trigger. Before this, below `lg` the panel
 *                         simply stacked a full-width nav block above the
 *                         content, with no drawer at all.
 *   aside.portal-sidebar  desktop rail (lg and up). `.portal-sidebar` is the
 *                         fixed deep-navy panel from tds-shared's app.css: it
 *                         re-maps --color-ink/-muted/-line/-soft/-card and
 *                         --nav-hue *within* the panel, so every child reads
 *                         light automatically in BOTH themes. The class sat
 *                         unused for a long time and this shell rendered a
 *                         plain paper-coloured column instead — which is why the
 *                         panel looked nothing like the customer portal.
 *   div.nav-drawer        mobile drawer (below lg). `.nav-drawer-panel` shares
 *                         the exact same navy surface + token remap, so the
 *                         slide-in reads identically to the desktop rail.
 *   main#main             the page slot.
 *
 * The rail and the drawer both render `<NavList sections={navSections} />` and
 * `<BrandWordmark />`, so there is one source of truth for the MARKUP as well
 * as the data. They previously shared the data but hand-copied the markup, and
 * the copies had already drifted (only the rail set `data-nav`).
 *
 * GOTCHA — do NOT put a multi-line JSX expression comment in this file's
 * template body. Astro compiles the template into a template literal and
 * mis-parses it, failing the build with a bare `Expected ")" but found "{"`
 * that points at the comment's own closing line, not at anything real. Put
 * notes in frontmatter (like this) or use an HTML comment.
 */

// One resolved nav model, rendered by <NavList> in both the rail and the
// drawer. Active state is baked in here so the path-normalisation rules stay
// in this file only; the section `hue` drives `--nav-hue`, which app.css has
// always read and nothing ever set — that is what makes the rail read as
// colour-coded zones instead of one grey column.
const navSections: NavSection[] = [...groups.entries()].map(([key, items]) => ({
  label: groupLabel(key),
  hue: hueForKey(key),
  items: [...items]
    .sort((a, b) => a.order - b.order)
    .map((item) => ({
      href: item.href,
      label: item.label,
      id: item.id,
      icon: item.icon,
      // An absolute URL can never match a pathname, so this is always false for
      // an external entry — stated rather than special-cased.
      active: isActive(item.href),
      external: item.external,
      revealFor: item.revealFor,
    })),
}));
---

<!DOCTYPE html>
<!-- data-surface selects the geometry layer from tds-shared's design library
     (surfaces/panel.css): the 8px product-UI geometry, 0.75rem chips and,
     since 0.15.0, a soft resting elevation.

     data-frontend selects the ACCENT within that layer, and is the only
     styling value FRONTEND_TARGET is allowed to drive: management reads the
     brand navy, the customer portal reads teal, so a user with both open
     knows at a glance which surface they are on. Everything else about the
     two products stays identical — one shell, one component set, one
     geometry. The accent is a single token block in surfaces/panel.css
     ([data-surface="panel"][data-frontend="customer"]); no component
     anywhere branches on the target. -->
<html lang={lang} data-surface="panel" data-frontend={FRONTEND_TARGET}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />

    {/* Where the composed API lives, for code that was built long before this
        product was. Every extension island calls the backend through
        tds-shared's `apiFetch`, which reads this — it cannot use
        `import.meta.env`, because it ships as a built package inside a
        consumer's node_modules and a PUBLIC_* substitution is not something a
        published package may rely on. Without it a relative call resolves
        against THIS static host, whose SPA fallback answers 200 + HTML: the
        island sees res.ok, json() throws, and the catch renders a calm empty
        state. That is what made the contact inbox report "Keine Anfragen." */}
    <meta name="tds-api-base" content={API_BASE} />

    {/* No-flash theme bootstrap — shared with the landingpage and the blog
        (tds-shared/astro). Must stay `is:inline` and must stay BEFORE the
        pre-paint auth gate below: the gate's spinner is painted in the theme's
        colours, so a theme applied after it would flash the wrong backdrop. */}
    <script is:inline set:html={themeBootstrapScript} />

    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <title>{title}</title>

    {
      !bare && (
        <>
          {/* Pre-paint gate. This MUST stay an inline style element: it paints
              before the CSS bundle loads, which is the entire point — so it
              cannot use the shared .tds-spinner class and the token fallbacks
              have to be literal hexes.
              NB keep angle brackets OUT of Astro expression comments: the
              template tokenizer reads one as a tag and the build dies with
              "Expected )".
              KEEP IN SYNC with base.css: the geometry and timing below are
              deliberately identical to .tds-spinner--lg.tds-spinner--primary
              (2.25rem, 3px, 20% ring, cubic-bezier(.5,.15,.5,.85), 0.7s); only
              the keyframe name differs, to avoid colliding with tds-spin. The
              hex fallbacks mirror --color-primary (#050f68) and the panel
              CANVAS, not --color-paper: since 0.15.0 the page sits on
              --tds-panel-canvas, a 4% accent tint over paper, so painting the
              gate in plain paper would step to a different colour the moment
              the bundle lands. Preferring the token and falling back to its
              computed literal (light #f0f1f1 / dark #0d101d) keeps the reveal
              seamless. The customer target's teal tint differs by ~1%, which
              is not worth a second literal for the few ms before CSS loads.
              If those tokens change in tds-shared, change these too.
              This block also carries its OWN reduced-motion query. It cannot
              rely on base.css's global clamp: the whole point of this style
              is that it paints BEFORE the CSS bundle loads, so during the
              exact window it is on screen the clamp does not exist yet. */}
          <style is:inline>
            html.auth-checking body { visibility: hidden; }
            html.auth-checking::before {
              content: ""; position: fixed; inset: 0; z-index: 2147483646;
              background: var(--tds-panel-canvas, #f0f1f1);
            }
            html[data-theme="dark"].auth-checking::before { background: var(--tds-panel-canvas, #0d101d); }
            html.auth-checking::after {
              content: ""; position: fixed; inset: 0; margin: auto; z-index: 2147483647;
              width: 2.25rem; height: 2.25rem; border-radius: 9999px;
              border: 3px solid color-mix(in srgb, var(--color-primary, #050f68) 20%, transparent);
              border-top-color: var(--color-primary, #050f68);
              animation: tds-auth-spin 0.7s cubic-bezier(0.5, 0.15, 0.5, 0.85) infinite;
            }
            @keyframes tds-auth-spin { to { transform: rotate(360deg); } }
            @media (prefers-reduced-motion: reduce) {
              html.auth-checking::after {
                animation: none;
                border-color: color-mix(in srgb, var(--color-primary, #050f68) 35%, transparent);
              }
            }
          </style>

          <script is:inline define:vars={{ authApiUrl, loginUrl: LOGIN_URL, hintKey, expKey, confirmedKey }}>
            (function () {
              function redirect() {
                // Bounce to the central login (auth.tracht-digital.de) with an
                // ABSOLUTE return URL — it validates ?next= against an allow-list
                // and sends the user back here after login.
                var next = encodeURIComponent(location.href);
                location.replace(loginUrl + "?next=" + next);
              }
              function clear() {
                try {
                  localStorage.removeItem(hintKey);
                  localStorage.removeItem(expKey);
                  localStorage.removeItem(confirmedKey);
                } catch (e) {}
              }
              var hint, exp, okUntil;
              try {
                hint = localStorage.getItem(hintKey);
                exp = localStorage.getItem(expKey);
                okUntil = localStorage.getItem(confirmedKey);
              } catch (e) { hint = null; }

              // A hint with a known-past expiry means the local session lapsed —
              // drop it and fall through to a fresh /me probe (the shared SSO
              // cookie may still be valid from another panel).
              if (hint) {
                var expMs = exp ? Number(exp) : NaN;
                if (Number.isFinite(expMs) && expMs <= Date.now()) { clear(); hint = null; }
              }

              // Fresh confirmation → paint immediately (only trusted with a hint).
              if (hint) {
                var okMs = okUntil ? Number(okUntil) : NaN;
                if (Number.isFinite(okMs) && okMs > Date.now()) return;
              }

              // Otherwise confirm against /me before revealing. This also covers
              // arriving fresh from the central login: the SSO cookie is set but
              // there is no local hint yet (localStorage is per-origin — the login
              // site cannot write this panel's). On success we SEED the hint here,
              // so we must NOT redirect on a missing hint (that would loop against
              // the login site, which sees a valid cookie and bounces straight
              // back). Only a 401 from /me is a real logout.
              document.documentElement.classList.add("auth-checking");
              function reveal() {
                try {
                  localStorage.setItem(hintKey, "1");
                  localStorage.setItem(confirmedKey, String(Date.now() + 60000));
                } catch (e) {}
                document.documentElement.classList.remove("auth-checking");
              }
              fetch(authApiUrl + "/me", { credentials: "include" }).then(function (res) {
                if (res.ok) { reveal(); return; }
                // Not logged in *yet*. A device with "angemeldet bleiben" holds a
                // 30-day cookie that can mint a fresh session — the session JWT
                // itself is deliberately short-lived, so without this exchange the
                // remembered login would still bounce to the login page every hour.
                return fetch(authApiUrl + "/refresh", { method: "POST", credentials: "include" })
                  .then(function (r) {
                    if (!r.ok) { clear(); redirect(); return; }
                    reveal();
                  });
              }).catch(function () {
                document.documentElement.classList.remove("auth-checking");
              });
            })();
          </script>
        </>
      )
    }
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <div class="lg:flex min-h-dvh">
          <header
            class="lg:hidden sticky top-0 z-40 flex items-center gap-3 px-4 py-3 border-b border-[color:var(--color-line)] bg-[color:var(--color-paper)]"
          >
            <button
              type="button"
              id="nav-drawer-open"
              class="btn btn-ghost"
              aria-controls="nav-drawer"
              aria-expanded="false"
              aria-label="Navigation öffnen"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
              </svg>
            </button>
            <BrandWordmark />
            <span class="ml-auto flex items-center gap-1">
              <ThemeToggle client:idle />
              <UserMenu client:idle compact />
            </span>
          </header>
          <aside class="portal-sidebar hidden lg:flex lg:flex-col w-60 shrink-0 border-r">
            <div class="sidebar-head px-4 py-4 flex items-center gap-2">
              <span class="sidebar-hide-collapsed"><BrandWordmark /></span>
              <button
                type="button"
                class="btn btn-ghost ml-auto px-2"
                data-sidebar-toggle
                aria-controls="panel-nav"
                aria-expanded="true"
                aria-label="Navigation einklappen"
              >
                <span data-expanded-icon><Icon name="chevrons-left" /></span>
                <span data-collapsed-icon hidden><Icon name="chevrons-right" /></span>
              </button>
            </div>
            <div id="panel-nav" class="flex-1 overflow-y-auto">
              <NavList sections={navSections} />
            </div>
            <div class="sidebar-foot mt-auto px-4 py-3 flex items-center gap-2">
              <!-- The ThemeToggle moved to the top bar, where it sits next to
                   the profile menu that now owns the rest of "my account".
                   Two toggles on one page would be two controls for one
                   setting. The target label stays: it is the only thing in
                   the rail that says which product this is. -->
              <span class="sidebar-hide-collapsed text-xs" style="color: var(--color-muted)">
                {FRONTEND_TARGET === "customer" ? "Kundenportal" : "Management"}
              </span>
            </div>
          </aside>
          <div class="nav-drawer lg:hidden" id="nav-drawer" data-open="false">
            <div class="nav-drawer-backdrop" data-nav-drawer-close></div>
            <div class="nav-drawer-panel">
              <div class="px-4 py-4 flex items-center gap-2">
                <BrandWordmark />
                <button
                  type="button"
                  class="btn btn-ghost ml-auto"
                  data-nav-drawer-close
                  aria-label="Navigation schließen"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
              <NavList sections={navSections} />
            </div>
          </div>

          <!-- The rail's neighbour is a COLUMN, not the page itself: the top
               bar has to sit above the canvas and stick while it scrolls.
               `min-w-0` on the column is what keeps a wide table inside it
               from pushing the whole layout out — `body { overflow-x: hidden }`
               would then clip it silently rather than scrolling it. -->
          <div class="flex flex-col min-w-0 flex-1">
            <header class="panel-topbar hidden lg:flex">
              <ThemeToggle client:idle />
              <UserMenu client:idle />
            </header>
            <main id="main" class="panel-main min-w-0 flex-1 p-4 sm:p-6">
              <div class="mx-auto w-full max-w-[90rem]">
                <slot />
              </div>
            </main>
          </div>
        </div>
        <script is:inline>
          (function () {
            var drawer = document.getElementById("nav-drawer");
            var trigger = document.getElementById("nav-drawer-open");
            if (!drawer || !trigger) return;
            var panel = drawer.querySelector(".nav-drawer-panel");

            var isOpen = function () {
              return drawer.getAttribute("data-open") === "true";
            };
            // Tab order inside the panel. Recomputed per use rather than
            // cached: the nav is server-rendered but the theme toggle inside
            // it hydrates late, so a list taken at load time is wrong.
            var focusables = function () {
              return Array.prototype.filter.call(
                panel.querySelectorAll("a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])"),
                function (el) { return el.offsetParent !== null; }
              );
            };

            function setOpen(open) {
              if (open === isOpen()) return;
              drawer.setAttribute("data-open", open ? "true" : "false");
              trigger.setAttribute("aria-expanded", open ? "true" : "false");
              document.body.style.overflow = open ? "hidden" : "";
              if (open) {
                var first = focusables()[0];
                if (first) first.focus();
              } else {
                // Back where they came from. Without this, closing drops focus
                // to the top of the document and a keyboard user has to tab
                // through the whole page to get anywhere.
                trigger.focus();
              }
            }

            trigger.addEventListener("click", function () {
              setOpen(!isOpen());
            });
            drawer.querySelectorAll("[data-nav-drawer-close]").forEach(function (el) {
              el.addEventListener("click", function () {
                setOpen(false);
              });
            });
            // Every nav entry is a full page load (this is an MPA), so without
            // this the drawer stays visibly open across the whole navigation.
            panel.addEventListener("click", function (e) {
              if (e.target.closest("a[href]")) setOpen(false);
            });

            document.addEventListener("keydown", function (e) {
              // Guarded on the open state. Unconditional, this also fired for
              // an Escape inside a <dialog> — and cleared `body.overflow`,
              // releasing a scroll lock that belonged to something else.
              if (!isOpen()) return;
              if (e.key === "Escape") {
                setOpen(false);
                return;
              }
              if (e.key !== "Tab") return;
              // The drawer covers the page but leaves the page focusable, so
              // Tab would walk out of it into content the user cannot see.
              var items = focusables();
              if (!items.length) return;
              var first = items[0];
              var last = items[items.length - 1];
              if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
              } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
              } else if (!panel.contains(document.activeElement)) {
                e.preventDefault();
                first.focus();
              }
            });
          })();
        </script>
        <script>
          import { initSidebarCollapse } from "../lib/sidebarCollapse";
          initSidebarCollapse();
        </script>
        <script>
          // NB no `define:vars` on this script: it implies `is:inline`, and an
          // inline script is not bundled — these imports would reach the
          // browser as bare specifiers. The target is imported from the same
          // module the frontmatter uses instead.
          import {
            setRequestHeadersProvider,
            setUnauthorizedHandler,
          } from "@tracht-digital-solutions/tds-shared/api";
          import { onUnauthorized } from "../lib/auth";
          import { actAsHeaders } from "../lib/activeCompany";
          import { initNotificationFeed } from "../lib/notificationFeed";
          import { initPreferences } from "../lib/preferences";
          import { revealNav } from "../lib/revealNav";
          import { FRONTEND_TARGET } from "../config/target";

          // Extension islands call the API through tds-shared's `apiFetch`,
          // which cannot reach into the host. Registering here is what finally
          // gives THEIR 401s the same backstop the host's own calls always had:
          // confirm against /me, try a refresh, and only then treat the session
          // as dead.
          setUnauthorizedHandler(onUnauthorized);

          // The active company rides on every COMPOSED-API call, so extension
          // islands read the tenant the user picked. The condition lives in
          // lib/activeCompany.ts with its own test — getting it wrong sends the
          // header to auth-api, whose CORS refuses it, and the login breaks.
          setRequestHeadersProvider(actAsHeaders);

          // Nav rows that depend on the principal (currently just "Meine
          // Firma"). Uses the memoised /me, so it costs no extra request.
          void revealNav();

          // One poller for every composed module. Not in `bare` mode: the
          // login/gate page has no session to poll with.
          initNotificationFeed({ target: FRONTEND_TARGET });

          // Reconcile the theme with the user's SERVER-side preference and
          // push later changes back. localStorage stays the pre-paint cache
          // (the no-flash bootstrap in <head> reads it synchronously); this is
          // what makes the choice follow the user to another device. Runs
          // after the gate, and it is idempotent — a layout <script> executes
          // per page, and a second listener would double every save.
          initPreferences();
        </script>
      )
    }

    {/* The ONE toast stack for both products. Mounted unconditionally — also in
        `bare` mode, because the login/gate page is exactly where a failure has
        to be visible. Anything (island, plain module, console) reaches it via
        the `tds:toast` window event; a second host anywhere would double every
        toast, so this is the only place it may be mounted. */}
    <ToastHost client:idle lang={lang} />
    <CookieNotice client:idle variant="panel" />
    {/* Floating support widget — renders only when the live-chat-cta extension
        enables this frontend (admin/customer) in the admin Einstellungen. Same
        relative API base as every other panel call. */}
    {!bare && <LiveChatCta client:idle frontend={FRONTEND_TARGET} lang={lang} />}
  </body>
</html>
