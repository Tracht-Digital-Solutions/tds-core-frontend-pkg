---
import Layout from "../layouts/Layout.astro";

/**
 * The panel's own "server error".
 *
 * Prerendered for the same reason as 404.astro, and the reason matters more
 * here: this page is shown when the Node app failed to render, so anything it
 * needed at request time would fail with it. As a plain file under the document
 * root, Apache hands it out without Node's involvement.
 *
 * It deliberately says nothing about the cause. The panel talks to the composed
 * API cross-origin from the browser, so a request that fails there surfaces in
 * the island that made it, with its HTTP status — this page only covers the
 * case where the shell itself could not be produced.
 */
export const prerender = true;
---

<Layout title="500 · Serverfehler" bare>
  <section class="tds-page">
    <div class="tds-page__head">
      <div>
        <p class="tds-page__eyebrow">Fehler 500</p>
        <h1 class="tds-page__title">Da ist etwas schiefgegangen</h1>
        <p class="tds-page__lede">
          Die Seite konnte nicht erzeugt werden. Ein erneuter Versuch hilft
          meistens; bleibt es dabei, liegt es am Server.
        </p>
      </div>
    </div>

    <div class="tds-card">
      <p class="tds-empty">Die Anfrage wurde nicht beantwortet.</p>
      <div class="tds-row">
        <a class="btn btn-primary" href="/">Zur Übersicht</a>
      </div>
    </div>
  </section>
</Layout>
