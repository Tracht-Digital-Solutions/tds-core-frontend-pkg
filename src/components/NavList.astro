---
/**
 * The panel navigation list — rendered identically by the desktop rail and the
 * mobile drawer.
 *
 * Both used to hand-copy this ~30-line block. The data was already shared, but
 * the MARKUP was not, and the two copies had drifted: the rail set `data-nav`
 * on every link and the drawer omitted it, so anything keying off that
 * attribute silently worked on desktop only. Rendering both from here makes
 * the "one source of truth" claim in Layout.astro actually true.
 *
 * Active state and the section hue arrive pre-resolved (`item.active`,
 * `section.hue`) rather than as callbacks, so this component stays pure
 * presentation and the rules live in exactly one place each — path
 * normalisation in Layout.astro's `isActive`, colour in lib/panelHues.ts.
 */
import Icon from "./Icon.astro";
import { REVEAL_CACHE_KEY } from "../lib/revealNav";

// The model types live with the code that builds them (lib/navModel.ts);
// re-exported so existing imports keep working.
export type { NavItem, NavSection } from "../lib/navModel";
import type { NavSection } from "../lib/navModel";

interface Props {
  sections: NavSection[];
}

const { sections } = Astro.props;
---

<nav class="px-2 pb-6 flex flex-col gap-0.5" aria-label="Hauptnavigation">
  {
    sections.map((section) => (
      <div
        class="nav-group flex flex-col gap-0.5"
        data-nav-group={section.key}
        style={section.hue ? `--nav-hue: ${section.hue}` : undefined}
      >
        {section.label ? <p class="nav-group-label">{section.label}</p> : null}
        {section.items.map((item) => (
          <a
            class:list={["nav-item", "px-3 py-2", item.active && "nav-item--active"]}
            href={item.href}
            data-nav={item.id}
            data-tip={item.external ? `${item.label} (neuer Tab)` : item.label}
            aria-current={item.active ? "page" : undefined}
            data-reveal-for={item.revealFor}
            data-reveal-permission={item.permission}
            hidden={item.revealFor !== undefined || item.permission !== undefined}
            target={item.external ? "_blank" : undefined}
            {/* `noopener` is the security half (the opened page cannot reach
                back through window.opener); `noreferrer` keeps it from learning
                which panel page the visit came from. */}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <span class="nav-item__icon">
              <Icon name={item.icon} />
            </span>
            <span class="nav-item__label">{item.label}</span>
          </a>
        ))}
      </div>
    ))
  }
  {/* Paints the rows the last /me granted before the first frame; revealNav
      then applies the live answer both ways. Mirrors applyReveal for this
      nav only — keep the two in step. */}
  <script is:inline define:vars={{ key: REVEAL_CACHE_KEY }}>
    (function () {
      try {
        var g = JSON.parse(localStorage.getItem(key) || "null");
        var nav = document.currentScript && document.currentScript.parentElement;
        if (!g || !nav) return;
        var rows = nav.querySelectorAll("[data-reveal-for], [data-reveal-permission]");
        for (var i = 0; i < rows.length; i++) {
          var r = rows[i], c = r.getAttribute("data-reveal-for"), p = r.getAttribute("data-reveal-permission");
          r.hidden = c ? g.flags[c] !== true : !(g.admin || (p && g.permissions.indexOf(p) !== -1));
        }
      } catch (e) {}
    })();
  </script>
</nav>

<style>
  /* A section whose every row is gated away keeps no orphaned heading. */
  .nav-group:not(:has(> .nav-item:not([hidden]))) {
    display: none;
  }
</style>
