{
  "name": "@tracht-digital-solutions/tds-core-frontend",
  "version": "0.27.0",
  "description": "Base panel host for the TDS panel platform. Ships the shell (Layout, auth gate), base pages (dashboard, login, users, settings, wiki) + the coreFrontendBase Astro integration. Consumed by the product repos (tds-admin-panel / tds-customer-panel), each of which composes it with its own extension set + deploy pipeline.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "require": "./dist/astro.cjs"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint:primitives": "node scripts/lint-primitives.mjs",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check:extensions": "tsc -p tsconfig.extcheck.json"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@tracht-digital-solutions/tds-frontend-contract": "^1.11.0",
    "@tracht-digital-solutions/tds-shared": "^0.34.0"
  },
  "peerDependencies": {
    "@astrojs/react": ">=6",
    "@tailwindcss/postcss": ">=4",
    "astro": ">=6",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.6",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tracht-Digital-Solutions/tds-core-frontend-pkg.git"
  }
}
